{
  "openai_function_calling": {
    "type": "function",
    "function": {
      "name": "<tool_name>",
      "description": "<tool_description>",
      "parameters": {
        "type": "object",
        "properties": {
          "<param_name>": {
            "type": "<string|integer|number|boolean|array|object>",
            "description": "<param_description>"
          }
        },
        "required": ["<required_param_names>"]
      }
    }
  },
  "mcp_tool": {
    "name": "<tool_name>",
    "description": "<tool_description>",
    "inputSchema": {
      "type": "object",
      "properties": {
        "<param_name>": {
          "type": "<string|integer|number|boolean|array|object>",
          "description": "<param_description>"
        }
      },
      "required": ["<required_param_names>"]
    }
  },
  "response_envelope": {
    "success": {
      "ok": true,
      "data": {}
    },
    "error": {
      "ok": false,
      "error": "<human_readable_error_message>"
    }
  }
}
