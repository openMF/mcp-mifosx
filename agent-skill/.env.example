# Fineract Agent Skill Environment Configuration
# Copy this file to .env and fill in the values for your Fineract instance.

# ── Fineract API Connection ────────────────────────────────────────────
FINERACT_BASE_URL=https://sandbox.mifos.community/fineract-provider/api/v1
FINERACT_USERNAME=mifos
FINERACT_PASSWORD=password
FINERACT_TENANT_ID=default

# ── TLS / SSL ──────────────────────────────────────────────────────────
# Set to "true" ONLY for local dev with self-signed certs.
# Leave unset or "false" for production.
# FINERACT_SKIP_TLS_VERIFY=true

# ── Timeout (seconds) ────────────────────────────────────────────────
FINERACT_TIMEOUT=30
