<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.4</version>
        <relativePath/>
    </parent>

    <groupId>org.mifos.community</groupId>
    <artifactId>mifos-copilot-gateway</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>mifos-copilot-gateway</name>
    <description>
        Mifos Copilot Gateway: the LLM agent loop for the Mifos X web-app Copilot (ADR-001).
        Serves wire contract v1 over SSE, forwards the officer's own Fineract credential to
        every tool call, and pauses every write for human confirmation.
        The org.mifos.community.copilot.core package is framework-free (pure JDK + Jackson +
        SnakeYAML) so the Fineract plugin can embed it later without this Spring shell.
    </description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <!-- Used by copilot-core for tools.yaml; version managed by the Boot parent. -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
