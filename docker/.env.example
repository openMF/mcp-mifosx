# ── Fineract Connection ───────────────────────────────────────────────
MIFOSX_BASE_URL=https://sandbox.mifos.community/fineract-provider/api/v1
MIFOSX_USERNAME=mifos
MIFOSX_PASSWORD=password
MIFOSX_TENANT_ID=default

# ── LLM Provider (set at least one) ─────────────────────────────────
# Pi supports 15+ providers. Set the key for your chosen provider.
# See: https://pi.dev/models
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
