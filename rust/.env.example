MIFOSX_BASE_URL=https://localhost:8443/fineract-provider/api/v1
MIFOSX_USERNAME=<your_username>
MIFOSX_PASSWORD=<your_password>
MIFOSX_TENANT_ID=default

# SSL/TLS Verification (set to "true" only for local development with self-signed certs)
# For production, leave this unset or set to "false"
# MIFOSX_SKIP_TLS_VERIFY=true

# ---------------------------------------------------------------------------
# Semantic Intent Router (get_relevant_tools)
# ---------------------------------------------------------------------------
# The router embeds the user query and matches it against banking domains
# so only relevant tools are returned (context-window pruning).
#
# Provider selection (pick one):
#
#   MIFOS_EMBEDDING_PROVIDER=ollama     # recommended – uses your local Ollama
#   MIFOS_EMBEDDING_PROVIDER=openai     # any OpenAI-compatible endpoint
#   MIFOS_EMBEDDING_PROVIDER=local      # original Candle + HuggingFace download
#
# If unset, the server auto-selects "ollama" when MIFOS_EMBEDDING_BASE_URL or
# OLLAMA_HOST is present, otherwise "local".

# --- Ollama (recommended) -------------------------------------------------
# MIFOS_EMBEDDING_PROVIDER=ollama
# MIFOS_EMBEDDING_BASE_URL=http://host.docker.internal:11434   # or http://ollama:11434
# MIFOS_EMBEDDING_MODEL=all-minilm                              # ollama pull all-minilm
# (OLLAMA_HOST is also accepted as a fallback for the base URL)

# --- OpenAI-compatible (vLLM, LM Studio, OpenAI, …) ----------------------
# MIFOS_EMBEDDING_PROVIDER=openai
# MIFOS_EMBEDDING_BASE_URL=http://localhost:1234/v1
# MIFOS_EMBEDDING_MODEL=text-embedding-3-small
# MIFOS_EMBEDDING_API_KEY=sk-...          # or OPENAI_API_KEY

# --- Local Candle (original behaviour) ------------------------------------
# MIFOS_EMBEDDING_PROVIDER=local
# MIFOS_EMBEDDING_MODEL_PATH=/models/all-MiniLM-L6-v2   # optional pre-downloaded dir
# HF_TOKEN=hf_...                                        # helps with rate limits

# Disable the feature completely (keyword-only routing, no network calls):
# MIFOS_DISABLE_SEMANTIC_ROUTER=1

# ---------------------------------------------------------------------------
# Transport
# ---------------------------------------------------------------------------
# MCP_TRANSPORT=stdio          # default – Claude Desktop / local clients
# MCP_TRANSPORT=http           # Streamable HTTP (+ SSE) – recommended for Docker
#
# When MCP_TRANSPORT=http (or when MCP_PORT / PORT is set):
# MCP_HOST=0.0.0.0
# MCP_PORT=8080
# MCP_PATH=/mcp                # endpoint path (default /mcp)