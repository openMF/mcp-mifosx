{
  "about": "Shared golden vectors for the deterministic document capture-quality gate. Every MCP server (Python, Go, Java, Rust) must reproduce the expected verdict and the five signals for each PNG fixture within the stated tolerance; the verdict is compared exactly. Vectors are generated by python/scripts/generate_capture_gate_vectors.py.",
  "contract": "RETAKE | REVIEW | PASS",
  "signal_tolerance": 0.0005,
  "analysis_max_side": 512,
  "thresholds": {
    "retake": {
      "brightness": 0.1,
      "ink_ratio": 0.002,
      "sharpness": 0.08
    },
    "review": {
      "brightness": 0.25,
      "contrast": 0.18,
      "ink_ratio": 0.003,
      "sharpness": 0.13
    }
  },
  "cases": [
    {
      "name": "crisp_text_page",
      "description": "Readable page at the reference 512x384 size.",
      "media_type": "image/png",
      "image_base64": "",
