# Run ./scripts/gen-secrets.sh to create .env: it copies this file and fills
# every empty secret below with a generated value.
# .env is git-ignored; never commit real secrets.

# --- Apache Fineract ---------------------------------------------------------
# Postgres superuser password, used only to create the databases.
FINERACT_DB_ADMIN_PASSWORD=
# Password of the non-superuser role Fineract connects as.
FINERACT_DB_APP_PASSWORD=
# Timezone of the default tenant.
FINERACT_TIMEZONE=UTC
# Override to test another Fineract build (default: pinned digest in docker-compose.yml).
# FINERACT_IMAGE=apache/fineract:latest

# --- Mifos X web app ---------------------------------------------------------
# Host port for the web app (bound to 127.0.0.1 only).
WEBAPP_PORT=4200
# Pinned release by default; use openmf/web-app:dev for the latest merged code.
# WEBAPP_IMAGE=openmf/web-app:dev

# --- OpenFn Lightning --------------------------------------------------------
# Host port for the Lightning UI and API (bound to 127.0.0.1 only).
LIGHTNING_PORT=4000
# Admin user created on first start. The email is only a login name here.
LIGHTNING_ADMIN_EMAIL=admin@sandbox.local
LIGHTNING_ADMIN_PASSWORD=
# Postgres superuser (init script only) and the role Lightning connects as.
LIGHTNING_DB_ADMIN_PASSWORD=
LIGHTNING_DB_APP_PASSWORD=
# Phoenix signing secret and the at-rest encryption key for credentials.
LIGHTNING_SECRET_KEY_BASE=
LIGHTNING_PRIMARY_ENCRYPTION_KEY=
# Worker authentication: shared secret plus an RSA key pair (Lightning signs
# run tokens with the private key; the worker verifies them with the public one).
LIGHTNING_WORKER_SECRET=
LIGHTNING_WORKER_RUNS_PRIVATE_KEY=
LIGHTNING_WORKER_PUBLIC_KEY=
# Concurrent runs per worker.
LIGHTNING_WORKER_CAPACITY=2
# LIGHTNING_IMAGE=openfn/lightning:v2.19.0
# LIGHTNING_WORKER_IMAGE=openfn/ws-worker:v1.29.5

# --- Agentic gateway ---------------------------------------------------------
# Host port for the loan API (bound to 127.0.0.1 only).
GATEWAY_PORT=8080
# Shared secret OpenFn jobs send back to the gateway (X-OpenFn-Secret).
OPENFN_CALLBACK_SECRET=
