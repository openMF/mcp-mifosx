# Copy to .env and change every value marked CHANGE ME.
# .env is git-ignored; never commit real secrets.

# --- Apache Fineract ---------------------------------------------------------
# Postgres superuser password, used only to create the databases. CHANGE ME.
FINERACT_DB_ADMIN_PASSWORD=change-me
# Password of the non-superuser role Fineract connects as. Must differ from
# the admin password. CHANGE ME.
FINERACT_DB_APP_PASSWORD=change-me-too
# Timezone of the default tenant.
FINERACT_TIMEZONE=UTC
# Override to test another Fineract build (default: pinned digest in docker-compose.yml).
# FINERACT_IMAGE=apache/fineract:latest

# --- Mifos X web app ---------------------------------------------------------
# Host port for the web app (bound to 127.0.0.1 only).
WEBAPP_PORT=4200
# Pinned release by default; use openmf/web-app:dev for the latest merged code.
# WEBAPP_IMAGE=openmf/web-app:dev
