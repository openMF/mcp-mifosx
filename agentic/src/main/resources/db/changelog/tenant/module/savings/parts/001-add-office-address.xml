<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">    
    <changeSet author="fineract" id="savings-001-1">
        <!-- Robust preconditions: skip if table already exists -->
        <preConditions onFail="MARK_RAN">
            <or>
                <!-- Table doesn't exist: proceed with creation -->
                <not>
                    <tableExists tableName="m_office_address"/>
                </not>                
            </or>
        </preConditions>     
        <comment>Adding Address to Office</comment>        
        <!-- Create join table with proper constraints -->
        <createTable tableName="m_office_address">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <!-- NO default values for FK columns - 0 is not a valid reference -->
            <column name="office_id" type="BIGINT">
                <constraints nullable="false" unique="true"/> <!-- Enforces 1:1 -->
            </column>
            <column name="address_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="address_type_id" type="INT">
                <constraints nullable="false" foreignKeyName="fk_office_address_type" 
                           references="m_code_value(id)"/>
            </column>
            <column name="is_active" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Foreign key constraints (explicit for clarity and cross-DB compatibility) -->
        <addForeignKeyConstraint constraintName="fk_office_address_office"
                                baseTableName="m_office_address" baseColumnNames="office_id"
                                referencedTableName="m_office" referencedColumnNames="id"
                                onDelete="RESTRICT" onUpdate="RESTRICT"/>
        
        <addForeignKeyConstraint constraintName="fk_office_address_address"
                                baseTableName="m_office_address" baseColumnNames="address_id"
                                referencedTableName="m_address" referencedColumnNames="id"
                                onDelete="RESTRICT" onUpdate="RESTRICT"/>

        <!-- Indexes for query performance (matching m_client_address pattern) -->
        <createIndex indexName="idx_office_address_office" tableName="m_office_address">
            <column name="office_id"/>
        </createIndex>
        <createIndex indexName="idx_office_address_address" tableName="m_office_address">
            <column name="address_id"/>
        </createIndex>
        <createIndex indexName="idx_office_address_type" tableName="m_office_address">
            <column name="address_type_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
