# ── MifosX / Fineract API ──────────────────────────────────────────────

MIFOSX_BASE_URL=https://your-mifosx-instance.com/fineract-provider/api/v1
MIFOSX_USERNAME=your_username
MIFOSX_PASSWORD=your_password
MIFOSX_TENANT_ID=default

# SSL/TLS Verification (set to "true" only for local development with self-signed certs)
# For production, leave this unset or set to "false"
# MIFOSX_SKIP_TLS_VERIFY=true

# HTTP timeouts in seconds. A call fails rather than hangs when Fineract is
# slow: the connection must open within 10s, and no response byte may take
# longer than 60s to arrive. The read timeout applies between bytes, so a
# large report can still take longer overall.
# MIFOSX_CONNECT_TIMEOUT_SECONDS=10
# MIFOSX_READ_TIMEOUT_SECONDS=60

# ── MCP tool profile ──────────────────────────────────────────────────
# Which tools the MCP server exposes: a profile from profiles.toml, or "all".
# Unset means the read-only tools only.
# MCP_AGENT_PROFILE=read-only

# ── Banking Agent Server ───────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development          # development | production

# ── Security ──────────────────────────────────────────────────────────
SECRET_KEY=your_secret_key_here
API_KEY=your_api_key_here

# ── AI / LLM (Ollama - local, private) ───────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
# Choose model: qwen2.5:7b (default) | llama3.1 (stable, tested)
OLLAMA_MODEL=qwen2.5:7b